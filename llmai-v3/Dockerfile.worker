FROM node:20-alpine AS base

# Install dependencies
FROM base AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

# Build worker
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npx prisma generate
# Compile workers with TypeScript
RUN npx tsc --outDir dist --esModuleInterop --module commonjs --target ES2022 --moduleResolution node --paths '{"@/*": ["./src/*"]}' --baseUrl . src/workers/index.ts src/workers/*.ts src/lib/*.ts src/types/*.ts || true

# Production
FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 worker

COPY --from=deps /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/prisma ./prisma
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma

RUN mkdir -p uploads results && chown worker:nodejs uploads results

USER worker
CMD ["node", "dist/workers/index.js"]
